NODE_ENV=stage
POSTGRES_DB=acropora_ai
POSTGRES_USER=acropora_ai
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5.1
API_ACCESS_TOKEN=replace-with-a-long-random-api-access-token
# Base url of the Acropora OS API that serves the customer context endpoint.
ACROPORA_OS_BASE_URL=
# Raw service token for that endpoint. Server side only: it is never stored,
# never logged and never returned to a caller. Leave it empty here.
ACROPORA_OS_AI_SERVICE_TOKEN=

# How long to wait for the model, in milliseconds, before giving up and
# answering 504 ai_provider_timeout. Empty means 40000.
#
# This is the FIRST rung of the ladder and the only failure in it that carries
# a code and a duration, so it has to stay BELOW everything in front of it:
# the socket net at 45000 here, and the Next.js proxy at 50000 in the OS.
# See docs/timeout-chain.md.
ACROPORA_AI_OPENAI_TIMEOUT_MS=
# How many times to retry the model call. Empty means 0. A retry multiplies
# the wall clock invisibly, and the hop in front knows nothing about it.
ACROPORA_AI_OPENAI_MAX_RETRIES=

# The local domain and intent pre-filter in front of POST /v1/chat (card f5b8f7ba,
# slice 2). Exactly `true` turns it on; anything else, including empty, leaves the
# chat as it was. When on, an off-topic or unclear question gets a local answer and
# makes no model call and no catalogue search.
AI_CHAT_PREFILTER=

# The one-sentence colleague offer after the fourth customer turn (slice 3). Exactly
# `true`, AND AI_CHAT_PREFILTER on. OFF until the contact request exists (slices 4c,
# 4d): a customer who answers "yes, please" would get a model that does not know how a
# colleague is reached, and could invent an address or a promise.
AI_CHAT_COLLEAGUE_OFFER=


# The socket net: how long a connection may stay open with no answer written,
# in milliseconds. Empty means 45000.
#
# This is NOT a step on the ladder, it is the net under it. When it fires the
# caller gets no HTTP answer at all - no status, no code - so it must never be
# what fires in normal operation. It exists for a handler stuck somewhere the
# model timeout cannot reach, the database being the obvious one.
ACROPORA_AI_CONNECTION_TIMEOUT_MS=

# ACROPORA_AI_COMMIT is deliberately NOT listed as a value here.
#
# It is set by the deploy workflow from the sha it is deploying, and it
# travels through the shell environment rather than through this file. A value
# written here would be a stale one: it would survive the next deploy and make
# /health report the wrong commit, which is worse than reporting none.
#
# ACROPORA_AI_BUILT_AT is absent for the same reason, and one more. It is a
# BUILD argument: the deploy workflow stamps it one step before the build, and
# the Dockerfile bakes it into the image. Set here, it would be read at
# container start instead, and would then move on every recreate while the
# image stood still - which is exactly the case the field exists to catch.
